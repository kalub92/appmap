{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-map.local/schema/ids.schema.json",
  "title": "app-map id registry",
  "description": "01 R1 — app-map/ids.yaml (shared by every platform)",
  "definitions": {
    "screenId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "01 R2: snake_case screen id"
    },
    "elementId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
      "description": "01 R2: <feature>.<name>.<kind> (dotted, lowercase)"
    },
    "gateId": {
      "type": "string",
      "pattern": "^gate\\.[a-z0-9_]+$",
      "description": "01 R2: gate.<name>"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/screenId"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "static nav title; must equal the screen file's `title` when both are present (validate rule 2)"
          },
          "deep_link": {
            "type": "string",
            "pattern": "^(appmap://[a-z][a-z0-9_]*(\\?[A-Za-z0-9_.=&%\\-]*)?|none)$",
            "description": "route for the screen; must equal the screen file's `deep_link` with the query stripped (the screen file may add `?fixture=…`, 01 R5) — validate rule 2"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/gateId"
          },
          "dismiss": {
            "type": "string",
            "pattern": "^gate\\.[a-z0-9_]+\\.[a-z0-9_]+$",
            "description": "01 R2: gate.<name>.<verb> — the dismiss control, i.e. the SAFE escape; registered here, not under elements. Guided replay and the Maestro gate guard press it unattended, so it must never mean anything else."
          },
          "dismiss_intent_critical": {
            "type": "boolean",
            "description": "02 §10.6: the dismiss control's criticality; absent means false"
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^gate\\.[a-z0-9_]+\\.[a-z0-9_]+$",
                  "description": "01 R2: gate.<name>.<verb> — another control of the same dialog, e.g. the confirm half of a destructive prompt (issue #24). Reachable from a recipe only through `action: tap_gate`, never through dismiss_gate."
                },
                "intent_critical": {
                  "type": "boolean",
                  "description": "REQUIRED, unlike elsewhere where absence means false: a gate control is by construction the non-escape half of an interrupter, so the author must state whether pressing it commits something."
                }
              },
              "required": [
                "id",
                "intent_critical"
              ]
            },
            "description": "01 R7 / issue #24: controls of this gate other than `dismiss`. Without these a destructive confirmation is unautomatable — the Delete button is neither a gate control (only `dismiss` existed) nor an element (the `gate.` prefix is reserved)."
          }
        },
        "required": [
          "id",
          "dismiss"
        ]
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!screen\\.|gate\\.)[a-z0-9]+(\\.[a-z0-9_]+){2,}$",
            "description": "01 R2: <feature>.<name>.<kind> (three or more segments); screen. and gate. prefixes are reserved"
          },
          "kind": {
            "type": "string",
            "enum": [
              "button",
              "field",
              "list",
              "cell",
              "toggle",
              "tab",
              "picker",
              "link",
              "text",
              "sheet"
            ]
          },
          "intent_critical": {
            "type": "boolean"
          },
          "dynamic": {
            "type": "boolean"
          },
          "label_regex": {
            "type": "string",
            "minLength": 1,
            "format": "regex",
            "description": "07 §9: computed labels (\"3 invoices\")",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "kind"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "screens",
    "gates",
    "elements"
  ]
}
