{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-map.local/schema/mcp-allowlist.schema.json",
  "title": "MCP server allowlist",
  "description": "07 §6 — app-map/policy/mcp-allowlist.yaml, enforced by 06 R3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9\\-]*$"
          },
          "source": {
            "type": "string",
            "enum": [
              "in-repo",
              "npm",
              "binary"
            ]
          },
          "transport": {
            "type": "string",
            "enum": [
              "stdio",
              "http"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "description": "npm package name when source=npm; policy-check matches an npx server on `<package>@<version>` (06 R3)"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.\\-]+)?$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "source",
          "transport",
          "version",
          "reviewer",
          "reviewed_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "npm"
                }
              }
            },
            "then": {
              "properties": {
                "package": {
                  "type": "string"
                }
              },
              "required": [
                "package"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "in-repo"
                }
              }
            },
            "then": {
              "properties": {
                "command": {
                  "type": "string"
                },
                "args": {
                  "type": "array"
                }
              },
              "required": [
                "command",
                "args"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "servers"
  ]
}
