{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-map.local/schema/heal-report.schema.json",
  "title": "heal report",
  "description": "06 R6 — heal-report.json produced by `app-map run --all --headless --report`. Uploaded as a CI artifact: ids, step ids, strategies, scores and closed codes only (07 §2.4) — never Maestro output, hierarchy text, labels or paths.",
  "definitions": {
    "elementId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
      "description": "01 R2: <feature>.<name>.<kind> (dotted, lowercase)"
    },
    "locator": {
      "type": "object",
      "description": "02 §5.1 locator; discriminated by `strategy`",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "const": "a11y_id"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "strategy",
            "value",
            "weight"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "const": "role_label"
            },
            "value": {
              "$ref": "#/definitions/roleLabelValue"
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "strategy",
            "value",
            "weight"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "strategy",
            "value",
            "weight"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "const": "path"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z]+(\\[[0-9]+\\])?(/[A-Za-z]+(\\[[0-9]+\\])?)*$"
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "strategy",
            "value",
            "weight"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "const": "geometry"
            },
            "value": {
              "$ref": "#/definitions/point"
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "strategy",
            "value",
            "weight"
          ]
        }
      ]
    },
    "roleLabelValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/definitions/role"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "label_regex": {
          "type": "string",
          "minLength": 1,
          "format": "regex",
          "maxLength": 200,
          "description": "user-authored regex source; ≤200 chars and no nested quantifiers (validate rule 1 safe-regex check, 07 §4)"
        }
      },
      "required": [
        "role"
      ],
      "oneOf": [
        {
          "properties": {
            "label": {
              "type": "string"
            }
          },
          "required": [
            "label"
          ]
        },
        {
          "properties": {
            "label_regex": {
              "type": "string"
            }
          },
          "required": [
            "label_regex"
          ]
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "application",
        "window",
        "container",
        "navigationBar",
        "tabBar",
        "toolbar",
        "scrollView",
        "list",
        "cell",
        "button",
        "link",
        "tab",
        "toggle",
        "field",
        "secureField",
        "searchField",
        "picker",
        "staticText",
        "image",
        "alert",
        "sheet",
        "keyboard",
        "key",
        "other"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android"
      ]
    },
    "build": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.\\-]*$",
      "description": "build number as a string (02 §8)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipe": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "const": "headless"
          },
          "ok": {
            "type": "boolean"
          },
          "steps": {
            "type": "integer",
            "minimum": 0
          },
          "steps_done": {
            "type": "integer",
            "minimum": 0
          },
          "heals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "recipe": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "step": {
                  "type": "string",
                  "pattern": "^s[0-9]+[a-z]?$"
                },
                "element": {
                  "$ref": "#/definitions/elementId"
                },
                "old_strategy": {
                  "type": "string",
                  "enum": [
                    "a11y_id",
                    "role_label",
                    "text",
                    "path",
                    "geometry"
                  ]
                },
                "new_strategy": {
                  "type": "string",
                  "enum": [
                    "a11y_id",
                    "role_label",
                    "text",
                    "path",
                    "geometry"
                  ]
                },
                "old_locator": {
                  "$ref": "#/definitions/locator"
                },
                "new_locator": {
                  "$ref": "#/definitions/locator"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "runner_up_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "accepted": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "low_score",
                    "ambiguous",
                    "intent_critical_label_changed",
                    "no_expect",
                    "postcondition_failed",
                    "no_candidates"
                  ]
                },
                "intent_critical": {
                  "type": "boolean"
                },
                "build": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z][0-9A-Za-z.\\-]*$",
                  "description": "build number as a string (02 §8)"
                }
              },
              "required": [
                "recipe",
                "step",
                "element",
                "old_strategy",
                "score",
                "accepted",
                "reason",
                "intent_critical",
                "build"
              ]
            }
          },
          "fallback_step": {
            "type": "string",
            "pattern": "^s[0-9]+[a-z]?$",
            "description": "recipe step (s1…) or guided/headless entry step (s0, s0a…)"
          },
          "screen_seen": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]*|unknown)$"
          },
          "retries": {
            "type": "integer",
            "minimum": 0
          },
          "ms": {
            "type": "integer",
            "minimum": 0
          },
          "build": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.\\-]*$",
            "description": "build number as a string (02 §8)"
          },
          "error_code": {
            "type": "string",
            "enum": [
              "maestro_failed",
              "maestro_unavailable",
              "not_headless_eligible",
              "release_build_refused",
              "timeout",
              "hierarchy_unavailable"
            ],
            "description": "closed failure code; the free-text Maestro output stays in .local/server.log (07 §2.4)"
          },
          "failed_command_index": {
            "type": "integer",
            "minimum": 0,
            "description": "index of the Maestro command that failed (04 §6.1)"
          }
        },
        "required": [
          "recipe",
          "version",
          "mode",
          "ok",
          "steps",
          "steps_done",
          "heals",
          "retries",
          "ms",
          "build"
        ]
      }
    },
    "heals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipe": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "step": {
            "type": "string",
            "pattern": "^s[0-9]+[a-z]?$"
          },
          "element": {
            "$ref": "#/definitions/elementId"
          },
          "old_strategy": {
            "type": "string",
            "enum": [
              "a11y_id",
              "role_label",
              "text",
              "path",
              "geometry"
            ]
          },
          "new_strategy": {
            "type": "string",
            "enum": [
              "a11y_id",
              "role_label",
              "text",
              "path",
              "geometry"
            ]
          },
          "old_locator": {
            "$ref": "#/definitions/locator"
          },
          "new_locator": {
            "$ref": "#/definitions/locator"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "runner_up_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "accepted": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "accepted",
              "low_score",
              "ambiguous",
              "intent_critical_label_changed",
              "no_expect",
              "postcondition_failed",
              "no_candidates"
            ]
          },
          "intent_critical": {
            "type": "boolean"
          },
          "build": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.\\-]*$",
            "description": "build number as a string (02 §8)"
          }
        },
        "required": [
          "recipe",
          "step",
          "element",
          "old_strategy",
          "score",
          "accepted",
          "reason",
          "intent_critical",
          "build"
        ]
      },
      "description": "accepted heals (exported to YAML)"
    },
    "needs_human": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recipe": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "step": {
            "type": "string",
            "pattern": "^s[0-9]+[a-z]?$"
          },
          "element": {
            "$ref": "#/definitions/elementId"
          },
          "old_strategy": {
            "type": "string",
            "enum": [
              "a11y_id",
              "role_label",
              "text",
              "path",
              "geometry"
            ]
          },
          "new_strategy": {
            "type": "string",
            "enum": [
              "a11y_id",
              "role_label",
              "text",
              "path",
              "geometry"
            ]
          },
          "old_locator": {
            "$ref": "#/definitions/locator"
          },
          "new_locator": {
            "$ref": "#/definitions/locator"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "runner_up_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "accepted": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "accepted",
              "low_score",
              "ambiguous",
              "intent_critical_label_changed",
              "no_expect",
              "postcondition_failed",
              "no_candidates"
            ]
          },
          "intent_critical": {
            "type": "boolean"
          },
          "build": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.\\-]*$",
            "description": "build number as a string (02 §8)"
          }
        },
        "required": [
          "recipe",
          "step",
          "element",
          "old_strategy",
          "score",
          "accepted",
          "reason",
          "intent_critical",
          "build"
        ]
      },
      "description": "rejected heals: intent_critical or low score"
    }
  },
  "required": [
    "schema_version",
    "platform",
    "build",
    "generated_at",
    "runs",
    "heals",
    "needs_human"
  ]
}
