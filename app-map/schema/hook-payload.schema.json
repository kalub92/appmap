{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-map.local/schema/hook-payload.schema.json",
  "title": "Claude Code hook stdin payload",
  "description": "05 §3 — stdin of .claude/hooks/*.sh, also the ingest-socket request body (03 §2). Field names verified against the hooks reference at implementation time.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "enum": [
        "SessionStart",
        "PostToolUse",
        "PostToolUseFailure",
        "Stop",
        "PreCompact"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "startup",
        "resume",
        "clear",
        "compact"
      ]
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "tool_input": {
      "type": "object",
      "description": "driver tool arguments, e.g. {id}, {text}, {url}, {direction}; treated as opaque"
    },
    "tool_response": {
      "description": "driver tool result (MCP content/structuredContent); the snapshot is extracted best-effort by src/tree.ts extractSnapshot"
    },
    "error": {
      "type": "string",
      "description": "PostToolUseFailure: the tool error text"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "trigger": {
      "type": "string"
    },
    "custom_instructions": {
      "type": "string"
    },
    "tool_use_id": {
      "type": "string",
      "description": "Claude Code tool call id (PostToolUse / PostToolUseFailure)"
    }
  },
  "required": [
    "session_id",
    "hook_event_name"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "hook_event_name": {
            "enum": [
              "PostToolUse",
              "PostToolUseFailure"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tool_name": {
            "type": "string"
          },
          "tool_input": {
            "type": "object"
          }
        },
        "required": [
          "tool_name",
          "tool_input"
        ]
      }
    }
  ]
}
