{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-map.local/schema/drift-report.schema.json",
  "title": "drift report",
  "description": "06 R4 — drift-report.json (ids and scores only; CI artifact)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android"
      ]
    },
    "build": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.\\-]*$",
      "description": "build number as a string (02 §8)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "screen": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "broken",
              "skipped"
            ]
          },
          "marker_present": {
            "type": "boolean"
          },
          "required_present": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "missing_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
            },
            "uniqueItems": true
          },
          "hash_changed": {
            "type": "boolean"
          },
          "unresolvable_elements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
            },
            "uniqueItems": true
          },
          "ci_gate_referenced": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "screen",
          "status",
          "marker_present",
          "required_present",
          "missing_ids",
          "hash_changed",
          "unresolvable_elements",
          "ci_gate_referenced"
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "broken": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "degraded",
        "broken",
        "skipped",
        "blocking"
      ]
    }
  },
  "required": [
    "schema_version",
    "platform",
    "build",
    "generated_at",
    "screens",
    "summary"
  ]
}
